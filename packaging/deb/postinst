#!/bin/sh
set -eu

APP_DIR=/opt/ge360/ge360-rilievi-backend
DATA_DIR=/opt/ge360/data/rilievi
CONFIG_DIR=/etc/ge360-rilievi-backend
ENV_FILE=$CONFIG_DIR/ge360.env
SERVICE=ge360-rilievi-backend.service
SERVICE_USER=ge360
SERVICE_GROUP=ge360

if ! getent group "$SERVICE_GROUP" >/dev/null 2>&1; then
  groupadd --system "$SERVICE_GROUP"
fi
if ! id "$SERVICE_USER" >/dev/null 2>&1; then
  useradd --system --gid "$SERVICE_GROUP" --home-dir /var/lib/ge360 --create-home --shell /usr/sbin/nologin "$SERVICE_USER"
fi

install -d -m 0755 /opt/ge360
install -d -m 0750 -o "$SERVICE_USER" -g "$SERVICE_GROUP" "$DATA_DIR"
install -d -m 0750 -o root -g "$SERVICE_GROUP" "$CONFIG_DIR"

if [ ! -f "$ENV_FILE" ]; then
  cp "$APP_DIR/.env.example" "$ENV_FILE"
  chown root:"$SERVICE_GROUP" "$ENV_FILE"
  chmod 0640 "$ENV_FILE"
  echo "GE360: created $ENV_FILE"
else
  chown root:"$SERVICE_GROUP" "$ENV_FILE" || true
  chmod 0640 "$ENV_FILE" || true
  echo "GE360: existing configuration preserved: $ENV_FILE"
fi

chmod 0755 "$APP_DIR/scripts/preflight.sh"
python3 -m venv "$APP_DIR/.venv"

REQ_HASH="$(sha256sum "$APP_DIR/requirements.txt" | awk '{print $1}')"
HASH_FILE="$APP_DIR/.venv/.ge360-requirements.sha256"
OLD_HASH=""
if [ -f "$HASH_FILE" ]; then
  OLD_HASH="$(cat "$HASH_FILE" 2>/dev/null || true)"
fi
if [ "$REQ_HASH" != "$OLD_HASH" ]; then
  "$APP_DIR/.venv/bin/python" -m pip install --disable-pip-version-check --upgrade pip
  "$APP_DIR/.venv/bin/python" -m pip install --disable-pip-version-check -r "$APP_DIR/requirements.txt"
  printf '%s\n' "$REQ_HASH" > "$HASH_FILE"
fi

KEY_FILE=$DATA_DIR/.api-key
if [ ! -s "$KEY_FILE" ]; then
  "$APP_DIR/.venv/bin/python" - "$KEY_FILE" <<'PY'
from pathlib import Path
import os
import secrets
import sys

p = Path(sys.argv[1])
p.parent.mkdir(parents=True, exist_ok=True)
tmp = p.with_name(p.name + ".tmp")
tmp.write_text(secrets.token_urlsafe(48) + "\n", encoding="utf-8")
os.chmod(tmp, 0o600)
os.replace(tmp, p)
PY
fi
chown "$SERVICE_USER:$SERVICE_GROUP" "$KEY_FILE"
chmod 0600 "$KEY_FILE"

chown -R root:"$SERVICE_GROUP" "$APP_DIR"
chmod 0755 "$APP_DIR"
find "$APP_DIR/.venv" -type d -exec chmod a+rx {} + 2>/dev/null || true

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  systemctl enable "$SERVICE" >/dev/null 2>&1 || true
  if [ -d /run/systemd/system ]; then
    systemctl restart "$SERVICE"
  fi
fi

echo "GE360 Rilievi Backend installed."
echo "Control panel: http://127.0.0.1:9888/control/"
echo "Setup:         http://127.0.0.1:9888/setup/"
echo "API key:       $KEY_FILE"
echo "Config:        $ENV_FILE"
echo "Direct Bridge: sudo GE360_SERVICE_USER=ge360 bash $APP_DIR/scripts/install-direct-bridge.sh"
exit 0
