[Unit]
Description=GE360 daily configuration backup
After=local-fs.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/ge360-rilievi-backend/ge360.env
ExecStart=/usr/local/sbin/ge360-config-backup
User=root
Group=root
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/ge360/Backup/Configurazione /run/lock
