GE360_API_KEY=
GE360_REQUIRE_API_KEY=true
GE360_API_KEY_FILE=/opt/ge360/data/rilievi/.api-key
GE360_DATA_DIR=/opt/ge360/data/rilievi
GE360_DB_PATH=/opt/ge360/data/rilievi/ge360-rilievi.sqlite3
GE360_HOST=127.0.0.1
GE360_PORT=9888
GE360_CORS_ORIGINS=http://localhost,http://127.0.0.1,https://localhost,capacitor://localhost
GE360_JOB_WORKERS=2
GE360_DEFAULT_WALL_THICKNESS_MM=120
GE360_DEFAULT_WALL_HEIGHT_MM=2700
GE360_SNAP_TOLERANCE_MM=250
GE360_ORTHOGONAL_TOLERANCE_DEG=25
GE360_LENGTH_TOLERANCE_MM=0.5
GE360_AI_ENABLED=false
GE360_OLLAMA_URL=http://127.0.0.1:11434
GE360_OLLAMA_MODEL=qwen3:8b
GE360_OLLAMA_TIMEOUT=20

# Rilievo fedele: scarto accettato per lato = max(ABS_MM, REL * lunghezza)
GE360_ACCEPT_ABS_MM=10
GE360_ACCEPT_REL=0.005
GE360_MEASURE_SIGMA_MM=5
GE360_AUTO_CLOSE_MM=600
GE360_DIAGONAL_SNAP_DEG=12
GE360_BATH_TILING_HEIGHT_MM=2200

# GE360 DIRECT BRIDGE (WireGuard)
GE360_BRIDGE_ENABLED=true
GE360_BRIDGE_INTERFACE=wg0
GE360_BRIDGE_NETWORK=10.88.0.0/24
GE360_BRIDGE_SERVER_IP=10.88.0.1
GE360_BRIDGE_PORT=51820
GE360_BRIDGE_KEEPALIVE=25
GE360_PUBLIC_HOST=
GE360_BRIDGE_CONFIG_DIR=/etc/ge360/direct-bridge
GE360_BRIDGE_STATE_DIR=/var/lib/ge360/direct-bridge
GE360_BRIDGE_WG_CONFIG=/etc/ge360/direct-bridge/wireguard/wg0.conf
GE360_BRIDGE_AUTO_PORT_MAPPING=false

# Identità visuale PDF cliente
GE360_BRAND_NAME=EDIL MILAN STEVIC
GE360_BRAND_SUBTITLE=Restauri & Costruzioni · Trieste e provincia
GE360_BRAND_TAGLINE=Un artigiano, un unico referente
GE360_BRAND_LOGO=
