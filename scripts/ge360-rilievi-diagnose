#!/usr/bin/env bash
set -u
APP_DIR=/opt/ge360/ge360-rilievi-backend
ENV_FILE=/etc/ge360-rilievi-backend/ge360.env
DATA_DIR=/opt/ge360/data/rilievi
SERVICE=ge360-rilievi-backend.service
USER=ge360

ok(){ printf '[OK] %s\n' "$*"; }
bad(){ printf '[FAIL] %s\n' "$*"; }
info(){ printf '[INFO] %s\n' "$*"; }

echo "=== GE360 Rilievi diagnostics ==="
echo

command -v python3 >/dev/null 2>&1 && ok "python3: $(python3 --version 2>&1)" || bad "python3 missing"
[ -d "$APP_DIR" ] && ok "app directory: $APP_DIR" || bad "app directory missing"
[ -r "$ENV_FILE" ] && ok "config readable: $ENV_FILE" || bad "config missing/unreadable"
[ -d "$DATA_DIR" ] && ok "data directory: $DATA_DIR" || bad "data directory missing"
id "$USER" >/dev/null 2>&1 && ok "service user: $USER" || bad "service user missing"

if [ -x "$APP_DIR/.venv/bin/python" ]; then
  ok "virtualenv Python exists"
  if sudo -u "$USER" "$APP_DIR/.venv/bin/python" -c 'import fastapi, uvicorn, pydantic, numpy, scipy, shapely; import backend.main; print("backend import OK")' 2>&1; then
    ok "Python dependencies and backend import"
  else
    bad "backend import failed"
  fi
else
  bad "virtualenv missing: $APP_DIR/.venv"
fi

if [ -r "$DATA_DIR/.api-key" ] && [ -s "$DATA_DIR/.api-key" ]; then
  ok "API key exists"
else
  bad "API key missing or unreadable"
fi

if systemctl is-active --quiet "$SERVICE"; then
  ok "systemd service active"
else
  bad "systemd service inactive"
fi

if curl -fsS --max-time 3 http://127.0.0.1:9888/healthz >/dev/null 2>&1; then
  ok "HTTP healthcheck 127.0.0.1:9888/healthz"
else
  bad "HTTP healthcheck failed"
fi

echo
info "Unit:"
systemctl cat "$SERVICE" 2>/dev/null || true
echo
info "Last journal lines:"
journalctl -u "$SERVICE" -n 80 --no-pager 2>/dev/null || true
echo
info "Listening on 9888:"
ss -ltnp 2>/dev/null | grep ':9888' || true
echo
info "Disk/permissions:"
ls -ld "$APP_DIR" "$DATA_DIR" /var/lib/ge360 2>/dev/null || true
ls -l "$DATA_DIR/.api-key" "$ENV_FILE" 2>/dev/null || true
