[Unit]
Description=GE360 Rilievi Backend
After=network.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/ge360/ge360-rilievi-backend
EnvironmentFile=/opt/ge360/ge360-rilievi-backend/.env
ExecStartPre=/opt/ge360/ge360-rilievi-backend/scripts/preflight.sh
ExecStart=/opt/ge360/ge360-rilievi-backend/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 9888
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ge360/data/rilievi /opt/ge360/Documenti/Rilievi

[Install]
WantedBy=multi-user.target
